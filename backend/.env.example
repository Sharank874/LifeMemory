ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Embeddings
USE_COHERE=true
COHERE_API_KEY=your-cohere-key-here
OPENAI_API_KEY=your-openai-key-here
EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_DIMENSION=1024

# LLM keys
GEMINI_API_KEY=your-gemini-key-here
# Groq (fallback LLM — free tier available at console.groq.com)
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# App settings
MAX_RETRIEVED_MEMORIES=15
MAX_CONTEXT_TOKENS=4000
MIN_EVIDENCE_THRESHOLD=1
MIN_RELEVANCE_SCORE=0.3
